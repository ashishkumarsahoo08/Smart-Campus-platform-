# ========================================================
# SMART CAMPUS UNIFIED PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Ports & Host
PORT=3042
HTTP_PORT=3042
HTTPS_PORT=3443
HOST=0.0.0.0
NODE_ENV=production

# Institutional Identity
CAMPUS_NAME=Smart Campus Unified Platform
INSTITUTION_CODE=CAMPUS-2026
TIMEZONE=Asia/Kolkata

# Initial Root Administrator Setup
# Note: Changing this here is used when initializing or resetting database
DEFAULT_ADMIN_ID=ADM-001
DEFAULT_ADMIN_NAME=Dr. Ashish Ku. Sahoo
DEFAULT_ADMIN_PASSWORD=campus123

# Regional Language & Translation (Bhashini ULCA Govt of India)
# Register at: https://bhashini.gov.in/ulca to receive official institutional keys
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d5

# Voice & AI Assistant (Grok / xAI / Gemini)
# Obtain key at: https://console.x.ai/ or https://aistudio.google.com/
GROK_API_KEY=
GROK_MODEL=grok-beta

# Gate & Security Configuration
DEFAULT_GATE_NAME=Main Gate #1
GATE_QR_VALIDITY_HOURS=12

# Database & Backups (Local JSON persistence)
DB_FILE=backend/data/campus_db.json
BACKUP_INTERVAL_HOURS=1

# Supabase PostgreSQL Cloud Database Integration
# Project ID: cvpupibxsrqrvfsnutmz
SUPABASE_PROJECT_ID=cvpupibxsrqrvfsnutmz
SUPABASE_URL=https://cvpupibxsrqrvfsnutmz.supabase.co
# Paste your anon public key or service_role key from:
# https://supabase.com/dashboard/project/cvpupibxsrqrvfsnutmz/settings/api
SUPABASE_KEY=

# Security & CORS
# Comma-separated list of allowed origins, or '*' for public access
CORS_ORIGIN=*
DISABLE_RATE_LIMIT=false

