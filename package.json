{
  "name": "smart-campus-platform",
  "version": "2.0.0",
  "description": "Smart Campus Full-Stack Dynamic Institutional Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "node scripts/test-api.js",
    "healthcheck": "node scripts/healthcheck.js",
    "backup": "node scripts/backup.js",
    "docker:build": "docker build -f docker/Dockerfile -t smart-campus-platform:2.0 .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "cap:sync": "cap copy android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@cometchat/chat-sdk-javascript": "^4.2.0",
    "@supabase/server": "^1.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "smart-campus",
    "education",
    "institutional-portal",
    "gate-pass",
    "attendance",
    "bhashini",
    "pwa"
  ],
  "author": "Smart Campus Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
